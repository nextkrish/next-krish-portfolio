# Gmail delivery: use a Google app password, never your regular account password.
GMAIL_USER=workwithdevskrish@gmail.com
GMAIL_APP_PASSWORD=

# Optional: set your own verified sender and server-only Resend API key to enable direct form delivery.
# Gmail is the selected provider. Missing providers produce an honest unsent error.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Set after choosing the public domain, for sitemap URLs.
NEXT_PUBLIC_SITE_URL=

# Optional Google Search Console HTML verification token (not a password).
GOOGLE_SITE_VERIFICATION=
